# Copie para .env e preencha. O .env não vai para o git.

# Porta publicada do app (o nginx atende HTTP; coloque um proxy com HTTPS na frente).
LERN_PORT=8080

# Senha do banco (interna; só a API acessa). Ex.: openssl rand -hex 24
POSTGRES_PASSWORD=

# Hash da sua senha de login. Gere com: npm run hash-password
LERN_PASSWORD_HASH=

# Segredo que assina o cookie de sessão (>= 32 caracteres). Ex.: openssl rand -hex 32
SESSION_SECRET=

# true em produção (cookie só via HTTPS). Use false apenas para testar em http://localhost.
COOKIE_SECURE=true
